# Newsletter Module Environment Variables
# Copy this file to .env and fill in your values

# ===== REQUIRED =====

# Directus Configuration
DIRECTUS_URL=http://localhost:8055
# DIRECTUS_URL=https://your-directus-instance.com

# Authentication Token (for static auth type)
DIRECTUS_TOKEN=your-directus-token-here
# Get this from: Directus Admin → Settings → API Keys

# ===== OPTIONAL =====

# SendGrid Configuration (for email sending)
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
SENDGRID_WEBHOOK_SECRET=your-webhook-verification-key

# Admin token for webhook operations (if different from DIRECTUS_TOKEN)
DIRECTUS_ADMIN_TOKEN=your-admin-token-here

# Public site URL (for links in emails)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== DEVELOPMENT ONLY =====

# Session secret (if using session-based auth)
SESSION_SECRET=your-session-secret-for-development

# ===== NOTES =====

# 1. DIRECTUS_URL: Your Directus instance URL
#    - Development: http://localhost:8055 
#    - Production: https://your-directus.com

# 2. DIRECTUS_TOKEN: Static token for API access
#    - Create in Directus: Settings → API Keys → Create Token
#    - Needs permissions for newsletter collections

# 3. SENDGRID_API_KEY: For sending emails
#    - Get from: https://app.sendgrid.com/settings/api_keys
#    - Needs "Mail Send" permission

# 4. SENDGRID_WEBHOOK_SECRET: For email analytics
#    - Get from: SendGrid → Settings → Mail Settings → Event Webhook
#    - Optional but recommended for analytics

# 5. Never commit this file to version control!
#    The .env file should be in your .gitignore