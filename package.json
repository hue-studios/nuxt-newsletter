{
  "name": "@hue-studios/nuxt-newsletter",
  "version": "1.0.3",
  "description": "Modern MJML newsletter module for Nuxt 3 with Directus CMS, SendGrid integration, and Tailwind CSS 4",
  "keywords": [
    "nuxt",
    "nuxt3",
    "newsletter",
    "email",
    "mjml",
    "directus",
    "sendgrid",
    "cms",
    "tailwindcss",
    "tailwindcss4",
    "drag-drop",
    "modern-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hue-studios/nuxt-newsletter.git"
  },
  "license": "MIT",
  "author": "Hue Studios",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    },
    "./composables": {
      "types": "./dist/runtime/composables/index.d.ts",
      "import": "./dist/runtime/composables/index.mjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.cjs"
    }
  },
  "main": "./dist/module.cjs",
  "types": "./dist/types.d.ts",
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "dev:clean": "rm -rf node_modules/.cache dist playground/.nuxt playground/dist && npm run dev:prepare",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "test:ci": "node scripts/run-tests.js",
    "setup:directus": "node scripts/install-directus-collections.js",
    "setup:blocks": "node scripts/create-advanced-blocks.js",
    "setup:templates": "node scripts/create-templates.js",
    "setup:wizard": "node scripts/setup-wizard.js",
    "verify": "node scripts/verify-setup.js"
  },
  "dependencies": {
    "@nuxt/kit": "^3.17.0",
    "defu": "^6.1.4",
    "ofetch": "^1.4.1"
  },
  "devDependencies": {
    "@directus/sdk": "^20.0.0",
    "@nuxt/devtools": "^1.7.0",
    "@nuxt/eslint-config": "^0.7.2",
    "@nuxt/module-builder": "^0.8.4",
    "@nuxt/schema": "^3.17.0",
    "@nuxt/test-utils": "^3.19.0",
    "@nuxtjs/color-mode": "^3.5.1",
    "@tailwindcss/vite": "^1.0.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vueuse/nuxt": "^11.3.0",
    "changelogen": "^0.6.2",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^26.1.0",
    "nuxt": "^3.17.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
  },
  "peerDependencies": {
    "@directus/sdk": ">=20.0.0",
    "@nuxt/icon": "^1.0.0",
    "@vueuse/nuxt": ">=11.0.0",
    "nuxt": "^3.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@directus/sdk": {
      "optional": false
    },
    "tailwindcss": {
      "optional": true
    },
    "@tailwindcss/vite": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "mjml": "^4.15.3",
    "mjml-browser": "^4.15.3",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^1.0.0",
    "tailwind-merge": "^3.3.1",
    "clsx": "^2.1.1",
    "tw-animate-css": "^1.3.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}